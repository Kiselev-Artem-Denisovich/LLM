# Очистка и нормализация текста

def normalize_text(text: str) -> str:
    """Убирает переносы по дефису, пробелы/табуляции,
    оставляет осмысленные переводы строк (для дальнейшего чанкинга)."""
    if not text:
        return ""
    text = re.sub(r'(\w)-\n(\w)', r'\1\2', text)
    text = re.sub(r'[ \t]+', ' ', text)
    text = re.sub(r'\n{3,}', '\n\n', text)
    return text.strip()


def strip_repeated_lines(pages_text: list[str], threshold: float = 0.6) -> list[str]:
    """Удаляет повторяющиеся колонтитулы PDF"""
    if len(pages_text) < 3:
        return pages_text
    n = len(pages_text)
    counter = Counter()
    for txt in pages_text:
        lines = [l.strip() for l in txt.splitlines() if l.strip()]
        if lines:
            counter[lines[0]] += 1
            if len(lines) > 1:
                counter[lines[-1]] += 1
    repeated = {ln for ln, cnt in counter.items()
                if cnt / n >= threshold and len(ln) < 200}
    cleaned_pages = []
    for txt in pages_text:
        kept = [l for l in txt.splitlines() if l.strip() not in repeated]
        cleaned_pages.append("\n".join(kept))
    return cleaned_pages


# Парсинг PDF

def _detect_pdf_headings(doc) -> dict[int, str]:
    headings: dict[int, str] = {}
    try:
        for _lvl, title, page in doc.get_toc(simple=True):
            if page >= 1 and title.strip():
                headings[page] = title.strip()
    except Exception:
        pass
    return headings


def _extract_pdf_tables(page) -> list[str]:
    """Извлечение таблиц штатным"""
    result: list[str] = []
    try:
        finder = page.find_tables()
    except Exception:
        return result
    for tbl in getattr(finder, "tables", []) or []:
        try:
            data = tbl.extract()
        except Exception:
            continue
        rows = []
        for row in data or []:
            cells = [(c or "").strip() for c in row]
            if any(cells):
                rows.append(" | ".join(cells))
        if rows:
            result.append("\n".join(rows))
    return result


def _extract_pdf_page_text(page) -> str:
    """Блочное извлечение с детекцией заголовков по размеру шрифта."""
    try:
        d = page.get_text("dict")
        sizes = [
            span["size"]
            for b in d.get("blocks", []) if b.get("type") == 0
            for l in b.get("lines", [])
            for span in l.get("spans", [])
            if span.get("text", "").strip()
        ]
        if not sizes:
            return page.get_text("text")
        median_size = sorted(sizes)[len(sizes) // 2]

        parts = []
        for b in d.get("blocks", []):
            if b.get("type") != 0:
                continue
            block_lines, is_heading = [], False
            for line in b.get("lines", []):
                line_text = "".join(
                    span.get("text", "") for span in line.get("spans", [])
                ).strip()
                if not line_text:
                    continue
                span_sizes = [
                    span["size"] for span in line["spans"]
                    if span.get("text", "").strip()
                ]
                if span_sizes and max(span_sizes) > median_size * 1.15:
                    is_heading = True
                block_lines.append(line_text)
            if not block_lines:
                continue
            text = " ".join(block_lines)
            parts.append(f"\n## {text}\n" if is_heading else text)
        return "\n".join(parts)
    except Exception:
        return page.get_text("text")


def load_pdf(path: str) -> list[Document]:
    source = os.path.basename(path)
    docs: list[Document] = []

    pdf = fitz.open(path)
    try:
        # Заголовки из TOC
        toc_headings = _detect_pdf_headings(pdf)

        # Текст + таблицы постранично
        raw_pages: list[str] = []
        tables_by_page: dict[int, list[str]] = {}
        for pn, page in enumerate(pdf, start=1):
            raw_pages.append(_extract_pdf_page_text(page))
            tables = _extract_pdf_tables(page)
            if tables:
                tables_by_page[pn] = tables

        # Снять повторяющиеся колонтитулы
        raw_pages = strip_repeated_lines(raw_pages)

        current_header = "Начало"
        toc_pages_sorted = sorted(toc_headings)
        for pn, page_text in enumerate(raw_pages, start=1):
            # Обновить текущий заголовок по TOC
            for tp in toc_pages_sorted:
                if tp <= pn:
                    current_header = toc_headings[tp]

            # Приклеить таблицы
            if pn in tables_by_page:
                page_text += "\n\n[ТАБЛИЦЫ]\n" + "\n\n".join(tables_by_page[pn])

            page_text = normalize_text(page_text)
            if not page_text:
                continue

            # Если на странице есть внутренний «## ...» — берём как header
            page_header = current_header
            m = re.search(r'^##\s+(.+)$', page_text, re.MULTILINE)
            if m:
                page_header = m.group(1).strip()

            docs.append(Document(
                page_text,
                metadata={
                    "source":    source,
                    "page":      pn,
                    "header":    page_header,
                    "file_type": "pdf",
                },
            ))
    finally:
        pdf.close()
    return docs


# Парсинг HTML

_HTML_SKIP_INSIDE = {"table", "dl", "pre", "code"}


def _html_block_to_text(el) -> str:
    """Продвинутое извлечение: таблицы, списки определений, код."""
    name = el.name
    if name == "table":
        rows = []
        for tr in el.find_all("tr"):
            cells = [c.get_text(" ", strip=True)
                     for c in tr.find_all(["th", "td"])]
            if any(cells):
                rows.append(" | ".join(cells))
        return "\n".join(rows)
    if name in ("pre", "code"):
        return "```\n" + el.get_text("\n", strip=False) + "\n```"
    if name == "dl":
        parts = []
        for child in el.find_all(["dt", "dd"], recursive=False):
            prefix = "### " if child.name == "dt" else "- "
            parts.append(prefix + child.get_text(" ", strip=True))
        return "\n".join(parts)
    return el.get_text(" ", strip=True)


def load_html(path: str) -> list[Document]:
    source = os.path.basename(path)
    with open(path, encoding="utf-8") as f:
        soup = BeautifulSoup(f.read(), "html.parser")

    page_title = (
        soup.title.get_text(strip=True) if soup.title else "Начало"
    ) or "Начало"
    content = soup.find(id="mw-content-text") or soup.body or soup

    docs: list[Document] = []
    header = page_title
    section_idx = 0

    for el in content.find_all(
        ["h1", "h2", "h3", "h4", "p", "li", "table", "dl", "pre", "figcaption"]
    ):
        skip = False
        for p in el.parents:
            if p is content:
                break
            if getattr(p, "name", None) in _HTML_SKIP_INSIDE:
                skip = True
                break
        if skip:
            continue

        if el.name in ("h1", "h2", "h3", "h4"):
            header = el.get_text(strip=True) or "Без заголовка"
            section_idx += 1
            continue

        text = normalize_text(_html_block_to_text(el))
        if not text:
            continue

        docs.append(Document(
            text,
            metadata={
                "source":    source,
                "page":      max(section_idx, 1),
                "header":    header,
                "file_type": "html",
            },
        ))
    return docs

def structure_aware_split(docs: list[Document]) -> list[Document]:
    size_splitter = RecursiveCharacterTextSplitter(
        chunk_size=500,
        chunk_overlap=50,
        separators=["\n\n", "\n", ". ", " ", ""],
    )

    result: list[Document] = []
    for doc in docs:
        text = doc.page_content
        parts = re.split(r'(?m)(?=^#{2,3}\s)', text)

        current_header = doc.metadata["header"]
        for part in parts:
            part = part.strip()
            if not part:
                continue

            m = re.match(r'^#{2,3}\s+(.+)', part)
            if m:
                current_header = m.group(1).strip()

            chunks = [part] if len(part) <= 500 else size_splitter.split_text(part)

            for ch in chunks:
                ch = normalize_text(ch)
                if not ch:
                    continue
                result.append(Document(
                    ch,
                    metadata={
                        "source":    doc.metadata["source"],
                        "page":      doc.metadata["page"],
                        "header":    current_header,
                        "file_type": doc.metadata["file_type"],
                    },
                ))
    return result



