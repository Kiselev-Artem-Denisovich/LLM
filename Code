# Промт с цитированием

def build_prompt(question: str, hits: list) -> str:
    """Собирает промпт: вопрос + контекст с явными метками источников."""
    if not hits:
        return (
            f"Вопрос пользователя: {question}\n\n"
            "В базе знаний нет информации по этому вопросу. "
            "Ответь: 'В предоставленных документах нет информации для ответа на этот вопрос.'"
        )

    context_blocks = []
    for i, doc in enumerate(hits, 1):
        md = doc.metadata
        source_label = (
            f"[{i}] {md.get('source', '?')}, "
            f"стр. {md.get('page', '?')}, "
            f"раздел: {md.get('header', '?')}"
        )
        context_blocks.append(
            f"--- ИСТОЧНИК {source_label} ---\n{doc.page_content}"
        )

    context_text = "\n\n".join(context_blocks)

    return f"""Ты — ассистент, который отвечает на вопросы ТОЛЬКО на основе предоставленных фрагментов документов.

ПРАВИЛА:
1. Используй только информацию из блоков «ИСТОЧНИК» ниже.
2. Каждое утверждение в ответе сопровождай ссылкой на номер источника в квадратных скобках, например: [1] или [2].
3. Если в источниках нет ответа — прямо напиши: «В предоставленных документах нет информации для ответа на этот вопрос.» Не выдумывай.
4. Не пересказывай источники целиком — дай краткий ответ по существу.

ВОПРОС ПОЛЬЗОВАТЕЛЯ:
{question}

ИСТОЧНИКИ:
{context_text}

ОТВЕТ (с обязательными ссылками на источники):"""


# ВызовLLM

def ask_llm(question: str, hits: list) -> str:
    """Отправляет вопрос + контекст в YandexGPT, возвращает текст ответа."""
    prompt = build_prompt(question, hits)
    result = model.run(prompt)
    for alternative in result:
        return alternative.text
    return "Модель не вернула ответ."


def validate_citations(answer: str, hits_count: int) -> str:
    """Предупреждает, если модель сослалась на несуществующий источник."""
    cited = {int(n) for n in re.findall(r'\[(\d+)\]', answer)}
    invalid = {n for n in cited if n < 1 or n > hits_count}
    if invalid:
        print(f"[WARN] Модель сослалась на несуществующие источники: {invalid}")
    return answer


# Цикл работы
def answer_question(question: str, k: int = 3) -> dict:
    """Полный пайплайн RAG: поиск фрагментов + ответ LLM со ссылками."""
    hits = retriever.invoke(question)

    print("\n--- Найденные фрагменты ---")
    if not hits:
        print("  (ничего не найдено)")
    else:
        for i, d in enumerate(hits, 1):
            md = d.metadata
            print(f"[{i}] {md.get('source', '?')} | стр. {md.get('page', '?')} "
                  f"| {md.get('header', '?')}")
            print(f"    {d.page_content[:150].replace(chr(10), ' ')}...")

    answer = ask_llm(question, hits)
    validate_citations(answer, len(hits))

    return {"question": question, "answer": answer, "sources": hits}


